# macOS. A pattern without a slash matches at every depth, so this already covers
# ./.DS_Store, cats/.DS_Store, cats/sub/.DS_Store, … (verified with `git check-ignore -v`).
.DS_Store

# Personal editor / AI-agent settings: machine-specific model names, prompts, token limits.
# Project agent config is deliberately tracked — see AGENTS.md and .agents/skills/.
.vscode/

# Build / dependency output (kept for future use)
node_modules/
dist/
build/

# Logs
*.log
